diff --git a/dlls/newdev/main.c b/dlls/newdev/main.c
index dcf7e391..faa56d80 100644
--- a/dlls/newdev/main.c
+++ b/dlls/newdev/main.c
@@ -165,3 +165,29 @@ BOOL WINAPI DiInstallDriverW(HWND parent, const WCHAR *inf_path, DWORD flags, BO
     FIXME("parent %p, inf_path %s, flags %#lx, reboot %p, stub!\n", parent, debugstr_w(inf_path), flags, reboot);
     return TRUE;
 }
+
+/***********************************************************************
+ *           DiUninstallDevice (NEWDEV.@)
+ */
+BOOL WINAPI DiUninstallDevice(HWND parent, HDEVINFO set, SP_DEVINFO_DATA *device, DWORD flags, BOOL *reboot)
+{
+    SP_DEVINSTALL_PARAMS_W params = {sizeof(params)};
+
+    TRACE("parent %p, set %p, device %p, flags %#lx, reboot %p.\n", parent, set, device, flags, reboot);
+
+    if (flags)
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+
+    if (reboot) *reboot = FALSE;
+
+    if (!SetupDiCallClassInstaller(DIF_REMOVE, set, device))
+        return FALSE;
+
+    if (reboot && SetupDiGetDeviceInstallParamsW(set, device, &params))
+        *reboot = !!(params.Flags & (DI_NEEDREBOOT | DI_NEEDRESTART));
+
+    return TRUE;
+}
